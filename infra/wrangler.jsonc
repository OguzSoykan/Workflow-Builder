{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "workflow-builder-local",
  "main": "../apps/worker/src/index.ts",
  "compatibility_date": "2026-10-22",
  "assets": {
    "directory": "../apps/web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"],
  },
  "dev": { "ip": "127.0.0.1", "port": 8787 },
  // Local-only placeholder ID (D-12): no cloud database exists; staging/production need real IDs.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "workflow-builder",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  // Single global AI budget ledger (ADR-021); SQLite-backed Durable Object class.
  "durable_objects": { "bindings": [{ "name": "AI_BUDGET", "class_name": "AiBudget" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AiBudget"] }],
  // Bindings and vars are not inherited by environments; each one declares its own (AC-13: separate data).
  // Database IDs are placeholders until the owner creates the databases; the deploy workflow refuses them.
  "env": {
    "staging": {
      "name": "workflow-builder-staging",
      // workers.dev is blocked on some networks; the custom domain is the primary staging address.
      "routes": [{ "pattern": "workflow-staging.oguzsoykan.com", "custom_domain": true }],
      "observability": { "enabled": true },
      "vars": {
        "AI_ENABLED": "true",
        "AI_PROVIDER": "mock",
        "FIREBASE_PROJECT_ID": "workflow-builder-staging-a31fe",
      },
      // FIREBASE_WEB_API_KEY is public but kept as a Worker secret so key scanners stay clean.
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "workflow-builder-staging",
          "database_id": "1a90c807-0675-4711-bc59-7ebe71508f1a",
          "migrations_dir": "migrations",
        },
      ],
      "durable_objects": { "bindings": [{ "name": "AI_BUDGET", "class_name": "AiBudget" }] },
    },
    "production": {
      "name": "workflow-builder-production",
      "observability": { "enabled": true },
      "vars": { "AI_ENABLED": "false", "AI_PROVIDER": "openai", "AI_MODEL": "gpt-6-luna" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "workflow-builder-production",
          "database_id": "00000000-0000-0000-0000-00000000bbbb",
          "migrations_dir": "migrations",
        },
      ],
      "durable_objects": { "bindings": [{ "name": "AI_BUDGET", "class_name": "AiBudget" }] },
    },
  },
}
