{
  "name": "workflow-builder",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": "24.22.1",
    "npm": "11.19.1"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces && tsc -p tsconfig.tools.json && tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "build": "npm run build --workspace=@workflow-builder/web && npm run build --workspace=@workflow-builder/worker && npm run build:envs --workspace=@workflow-builder/worker",
    "dev": "npm run build --workspace=@workflow-builder/web && npm run dev:worker",
    "dev:worker": "npm run dev --workspace=@workflow-builder/worker",
    "e2e:server": "npm run build --workspace=@workflow-builder/web && wrangler dev --config infra/wrangler.jsonc --local --port 8797 --show-interactive-dev-session=false",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --config infra/wrangler.jsonc",
    "dev:web": "npm run dev --workspace=@workflow-builder/web",
    "test": "vitest run && npm run test:security && npm run test:docs",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "node scripts/build-contract-probe.mjs && playwright test",
    "test:security": "node --test scripts/secret-scan.test.mjs scripts/release.test.mjs",
    "test:negative-gates": "node scripts/verify-negative-gates.mjs",
    "secret:scan": "node scripts/secret-scan.mjs",
    "test:docs": "node --test scripts/openapi.test.mjs",
    "deploy:check": "node scripts/check-deploy-config.mjs",
    "smoke": "node scripts/smoke.mjs",
    "dev:contract-test": "wrangler dev --config tests/platform/wrangler.jsonc --local --show-interactive-dev-session=false",
    "docs:sync-api": "node scripts/sync-openapi.mjs && prettier --write docs/openapi.json",
    "benchmark:validator": "node scripts/benchmark-validator.mjs",
    "benchmark:simulator": "node scripts/benchmark-simulator.mjs",
    "ai:eval": "node apps/worker/eval/run.mjs",
    "secrets:check": "node scripts/check-secrets.mjs",
    "secrets:self-test": "node scripts/check-secrets.mjs --self-test",
    "postinstall": "node scripts/patch-xyflow-types.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.58.2",
    "@types/node": "24.19.2",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "ajv": "8.20.0",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wrangler": "4.151.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261019.1": true
  },
  "overrides": {
    "miniflare": {
      "undici": "7.30.1"
    }
  }
}
