  "components": {
    "securitySchemes": {
      "firebaseBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Firebase ID token",
        "description": "Worker validates signature and claims; ownership comes from token sub, never client owner_uid."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "messageKey": {
                "type": "string"
              },
              "details": {}
            },
            "required": ["code", "messageKey"],
            "additionalProperties": false
          },
          "requestId": {
            "type": "string"
          }
        },
        "required": ["error", "requestId"],
        "additionalProperties": false,
        "examples": [
          {
            "error": {
              "code": "ROUTE_NOT_FOUND",
              "messageKey": "errors.routeNotFound"
            },
            "requestId": "synthetic-request-id"
          }
        ]
      },
      "Health": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "status": {
                "const": "ok"
              }
            },
            "required": ["status"],
            "additionalProperties": false
          },
          "meta": {
            "type": "object",
            "properties": {
              "requestId": {
                "type": "string"
              }
            },
            "required": ["requestId"],
            "additionalProperties": false
          }
        },
        "required": ["data", "meta"],
        "additionalProperties": false,
        "examples": [
          {
            "data": {
              "status": "ok"
            },
            "meta": {
              "requestId": "synthetic-request-id"
            }
          }
        ]
      },
      "PlannedResponse": {
        "type": "object",
        "description": "TBD: response payload will be finalized in the owning phase; this is not an implemented contract.",
        "x-decisions": ["D-03", "D-11", "D-15"]
      },
      "WorkflowDraft": {
        "type": "object",
        "description": "TBD (WB-002): canonical workflow schema, byte/input limits and field policies await D-02/D-04/D-15. This placeholder must not be used to validate runtime input.",
        "x-decisions": ["D-02", "D-04", "D-15"]
      },
      "ProfileUpdate": {
        "type": "object",
        "properties": {
          "preferredLocale": {
            "enum": ["tr", "en"]
          },
          "displayName": {
            "type": "string",
            "maxLength": 100
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "WorkflowCreate": {
        "type": "object",
        "properties": {
          "workflow": {
            "$ref": "#/components/schemas/WorkflowDraft"
          },
          "source": {
            "enum": ["manual", "ai_create", "ai_edit", "import", "restore"]
          }
        },
        "required": ["workflow", "source"],
        "additionalProperties": false
      },
      "WorkflowUpdate": {
        "type": "object",
        "properties": {
          "workflow": {
            "$ref": "#/components/schemas/WorkflowDraft"
          },
          "expectedRevision": {
            "type": "integer",
            "minimum": 1
          },
          "baseContentHash": {
            "type": "string"
          },
          "source": {
            "enum": ["manual", "ai_create", "ai_edit", "import", "restore"]
          }
        },
        "required": ["workflow", "expectedRevision", "baseContentHash", "source"],
