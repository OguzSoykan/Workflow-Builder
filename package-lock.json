{
  "name": "workflow-builder",
  "version": "0.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "workflow-builder",
      "version": "0.0.0",
      "workspaces": [
        "apps/*",
        "packages/*"
      ],
      "devDependencies": {
        "typescript": "6.0.3"
      },
      "engines": {
        "node": "24.22.1",
        "npm": "11.19.1"
      }
    },
    "apps/web": {
      "name": "@workflow-builder/web",
      "version": "0.0.0",
      "dependencies": {
        "@workflow-builder/workflow-contract": "0.0.0",
        "@workflow-builder/workflow-core": "0.0.0"
      }
    },
    "apps/worker": {
      "name": "@workflow-builder/worker",
      "version": "0.0.0",
      "dependencies": {
        "@workflow-builder/workflow-contract": "0.0.0",
        "@workflow-builder/workflow-core": "0.0.0"
      }
    },
    "node_modules/@workflow-builder/web": {
      "resolved": "apps/web",
      "link": true
    },
    "node_modules/@workflow-builder/worker": {
      "resolved": "apps/worker",
      "link": true
    },
    "node_modules/@workflow-builder/workflow-contract": {
      "resolved": "packages/workflow-contract",
      "link": true
    },
    "node_modules/@workflow-builder/workflow-core": {
      "resolved": "packages/workflow-core",
      "link": true
    },
    "node_modules/typescript": {
      "version": "6.0.3",
      "resolved": "https://registry.npmjs.org/typescript/-/typescript-6.0.3.tgz",
      "integrity": "sha512-y2TvuxSZPDyQakkFRPZHKFm+KKVqIisdg9/CZwm9ftvKXLP8NRWj38/ODjNbr43SsoXqNuAisEf1GdCxqWcdBw==",
      "dev": true,
      "license": "Apache-2.0",
      "bin": {
        "tsc": "bin/tsc",
        "tsserver": "bin/tsserver"
      },
      "engines": {
        "node": ">=14.17"
      }
    },
    "packages/workflow-contract": {
      "name": "@workflow-builder/workflow-contract",
      "version": "0.0.0"
    },
    "packages/workflow-core": {
      "name": "@workflow-builder/workflow-core",
      "version": "0.0.0",
      "dependencies": {
        "@workflow-builder/workflow-contract": "0.0.0"
      }
    }
  }
}
